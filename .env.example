# Optional live Hugging Face inference for the bounded AI Intake Organizer.
# Live inference is OFF unless LIVE_AI_ENABLED=true and HF_TOKEN is configured.
# Never place real credentials in this file or commit them to Git.

LIVE_AI_ENABLED=false
HF_TOKEN=your_runtime_token
MODEL_ID=Qwen/Qwen2.5-7B-Instruct-1M

# Local Gradio workflow checkpoint database. This file is gitignored.
WORKFLOW_DB_PATH=workflow_runs.db
